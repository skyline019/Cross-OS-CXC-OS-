riscv64-test-gcc -Wall -Werror -Wno-unknown-attributes -O -fno-omit-frame-pointer -ggdb -gdwarf-2 -ffile-prefix-map=/home/user/.cache/pmfs-sandbox/xv6-reboot-probe=. -march=rv64gc -std=gnu99 -MD -mcmodel=medany -ffreestanding -fno-common -nostdlib -fno-delete-null-pointer-checks -fno-builtin-strncpy -fno-builtin-strncmp -fno-builtin-strlen -fno-builtin-memset -fno-builtin-memmove -fno-builtin-memcmp -fno-builtin-log -fno-builtin-bzero -fno-builtin-strchr -fno-builtin-exit -fno-builtin-malloc -fno-builtin-putc -fno-builtin-free -fno-builtin-memcpy -Wno-main -fno-builtin-printf -fno-builtin-fprintf -fno-builtin-vprintf -I. -fno-stack-protector   -c -o user/pmreboot.o user/pmreboot.c
riscv64-test-ld -z max-page-size=4096 -T user/user.ld -o user/_pmreboot user/pmreboot.o user/ulib.o user/usys.o user/printf.o user/umalloc.o
riscv64-test-objdump -S user/_pmreboot > user/pmreboot.asm
riscv64-test-objdump -t user/_pmreboot | sed '1,/SYMBOL TABLE/d; s/ .* / /; /^$/d' > user/pmreboot.sym
