+static void virt_machine_device_pre_plug_cb(HotplugHandler *hotplug_dev,
+                                            DeviceState *dev, Error **errp)
+{
+    MachineState *ms = MACHINE(hotplug_dev);
+    if (!object_dynamic_cast(OBJECT(dev), TYPE_NVDIMM)) {
+        return;
+    }
+    if (dev->hotplugged || !ms->nvdimms_state->is_enabled || !ms->device_memory) {
+        error_setg(errp, "PMFS NVDIMM requires nvdimm=on and cold-plug");
+        return;
+    }
+    pc_dimm_pre_plug(PC_DIMM(dev), ms, errp);
+}
+
 static void virt_machine_device_plug_cb(HotplugHandler *hotplug_dev,
                                         DeviceState *dev, Error **errp)
 {
     RISCVVirtState *s = RISCV_VIRT_MACHINE(hotplug_dev);
 
+    if (object_dynamic_cast(OBJECT(dev), TYPE_NVDIMM)) {
+        MachineState *ms = MACHINE(hotplug_dev);
+        PCDIMMDevice *dimm = PC_DIMM(dev);
+        Error *local_err = NULL;
+        uint64_t size = memory_device_get_region_size(MEMORY_DEVICE(dev), &local_err);
+        if (local_err) {
+            error_propagate(errp, local_err);
+            return;
+        }
+        if (dimm->addr != 0x88000000ULL || size != 32 * MiB) {
+            error_setg(errp, "PMFS NVDIMM must occupy 0x88000000+32MiB");
+            return;
+        }
+        pc_dimm_plug(dimm, ms);
+        qemu_fdt_add_subnode(ms->fdt, "/pmem@88000000");
+        qemu_fdt_setprop_string(ms->fdt, "/pmem@88000000", "compatible",
+                                "xv6,pmfs-nvdimm");
+        qemu_fdt_setprop_sized_cells(ms->fdt, "/pmem@88000000", "reg",
+                                     2, dimm->addr, 2, size);
+        return;
+    }
+
     if (s->platform_bus_dev) {
         MachineClass *mc = MACHINE_GET_CLASS(s);
 
@@ -1800,6 +1852,7 @@
     HotplugHandlerClass *hc = HOTPLUG_HANDLER_CLASS(oc);
 
     mc->desc = "RISC-V VirtIO board";
